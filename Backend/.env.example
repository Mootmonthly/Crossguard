# Local Nakama settings. Tools/run_local_backend.sh / .ps1 copy this to Backend/.env (gitignored) on the
# first run and replace every "generate" value with a random one. Never commit Backend/.env.

# Clients send this to log in (it ships inside the game, so it is not a secret). Must match
# NakamaServerKey in Config/DefaultGame.ini ([/Script/Crossguard.CrossguardNakamaSubsystem]).
NAKAMA_SERVER_KEY=crossguard-dev

# SECRET: dedicated servers call the save / session RPCs with it (-NakamaHttpKey=). Never in a client.
NAKAMA_HTTP_KEY=generate

# SECRET: sign session tokens. Changing them logs everyone out.
NAKAMA_SESSION_ENCRYPTION_KEY=generate
NAKAMA_SESSION_REFRESH_KEY=generate

# Developer console (http://127.0.0.1:7351).
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=generate
NAKAMA_CONSOLE_SIGNING_KEY=generate

# Database (only reachable inside the compose network).
POSTGRES_PASSWORD=generate

# Steam login (docs/steam-setup.md). Empty: Steam login off. The publisher Web API key is SECRET.
STEAM_APP_ID=
STEAM_PUBLISHER_KEY=

# 1: device-id login allowed (development; anyone can claim any device id). 0 on any shared server.
CROSSGUARD_DEV_AUTH=1
